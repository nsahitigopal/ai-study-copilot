import fitz

from langchain_community.document_loaders import PyMuPDFLoader


def load_pdf(pdf_path):

    loader = PyMuPDFLoader(pdf_path)

    documents = loader.load()

    return documents


def extract_toc(pdf_path):
    """
    What enters : path to a PDF file
    What leaves : list of chapter dicts — [{ title, start_page, end_page }]
                  pages are 1-indexed to match reader conventions
    Why         : the sidebar needs chapter names and page ranges so we can
                  filter chunks to the right chapter during retrieval
    """

    # fitz gives us direct access to the PDF's embedded TOC
    # get_toc() returns [[level, title, page], ...] where page is 1-indexed
    doc = fitz.open(pdf_path)

    toc         = doc.get_toc()
    total_pages = doc.page_count

    doc.close()


    # Fallback: PDF has no embedded TOC at all
    if not toc:
        return [{
            "title":      "Full Document",
            "start_page": 1,
            "end_page":   total_pages,
        }]


    # Do not hardcode level == 1.
    # Some PDFs use level 1 for Parts and level 2 for Chapters.
    # Use whatever the top-most (lowest number) level actually is.
    min_level = min(entry[0] for entry in toc)
    chapters  = [entry for entry in toc if entry[0] == min_level]


    result = []

    for i, (level, title, start_page) in enumerate(chapters):

        # End page = one before the next chapter starts
        # Last chapter goes to the final page
        if i + 1 < len(chapters):
            end_page = chapters[i + 1][2] - 1
        else:
            end_page = total_pages

        result.append({
            "title":      title,
            "start_page": start_page,
            "end_page":   end_page,
        })

    return result
